[Unit]
Description=Expire only managed Stage10 DEVELOPMENT backups after seven days
# Installed only in the hermes user manager, never the root system manager.
ConditionUser=hermes

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /home/hermes/.hermes/worktrees/travelos-stage10/tooling/deployment/stage10-backup-retention-runner.py --run
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
TimeoutStartSec=60
Environment=PYTHONDONTWRITEBYTECODE=1
