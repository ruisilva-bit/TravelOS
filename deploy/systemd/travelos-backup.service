[Unit]
Description=TravelOS database backup (pg_dump)
After=postgresql.service

[Service]
Type=oneshot
User=travelos
Group=travelos
# Holds PGDATABASE, PGUSER, PGHOST and TRAVELOS_BACKUP_COPY_TO (optional).
EnvironmentFile=-/etc/travelos/backup.env
ExecStart=/srv/travelos/scripts/backup.sh
# /var/backups/travelos must exist and be owned by travelos (see runbook).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/travelos
ProtectHome=true
PrivateTmp=true
