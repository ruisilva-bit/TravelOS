[Unit]
Description=TravelOS Stage 8 DEVELOPMENT authenticated acceptance
After=travelos-admin-api.service travelos-portal-api.service travelos-worker.service
Requires=travelos-admin-api.service travelos-portal-api.service travelos-worker.service

[Service]
Type=oneshot
User=travelos-stage8-operator
DynamicUser=yes
WorkingDirectory=/opt/travelos/current
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
TimeoutStartSec=15min
Restart=no
LoadCredentialEncrypted=portal-api-db:/etc/credstore.encrypted/travelos-portal-api-db
LoadCredentialEncrypted=portal-auth-realm:/etc/credstore.encrypted/travelos-portal-auth-realm
LoadCredentialEncrypted=stage7-staff-email:/etc/credstore.encrypted/travelos-stage7-staff-email
LoadCredentialEncrypted=stage7-staff-password:/etc/credstore.encrypted/travelos-stage7-staff-password
LoadCredentialEncrypted=stage7-staff-totp:/etc/credstore.encrypted/travelos-stage7-staff-totp
LoadCredentialEncrypted=worker-db:/etc/credstore.encrypted/travelos-worker-db
ExecStartPre=/opt/travelos/current/runtime/node/bin/node /opt/travelos/current/deployment/verify-artifact.mjs --artifact-root=/opt/travelos/current
ExecStart=/opt/travelos/current/runtime/node/bin/node /opt/travelos/current/operator/stage8-runtime-acceptance.mjs --manifest=/etc/travelos/instances/development.json
StandardOutput=journal
StandardError=journal
