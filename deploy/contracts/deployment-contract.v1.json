{
  "schemaVersion": 1,
  "contractId": "travelos-stage6-ct-runtime-v1",
  "artifact": {
    "generation": 7,
    "artifactIdPrefix": "travelos-phase-1-m1-stage-6-gen07-",
    "sourceBranch": "phase-1/stage-6",
    "sourceBaselineGeneration": 7,
    "designation": "DEVELOPMENT_CANDIDATE_UNQUALIFIED",
    "productionSigningStatus": "NOT_PRODUCTION_SIGNED",
    "canonicalCiStatusAtBuild": "PENDING_ONE_AUTHORIZED_RUN",
    "releaseMetadataPath": "release.json",
    "sourceContractPath": "deploy/contracts/deployment-contract.v1.json",
    "contractPath": "deployment/deployment-contract.v1.json",
    "verifierPath": "deployment/verify-stage6-deployment-contract.mjs",
    "payloadManifestPath": "payload-manifest.json",
    "checksumsPath": "checksums.txt",
    "successorBaselinePath": "provenance/stage6-successor-baseline-generation-07-revision-03.json",
    "currentSymlink": "/opt/travelos/current",
    "releaseRoot": "/opt/travelos/releases",
    "runtimeNodePath": "runtime/node/bin/node",
    "adminWebPath": "admin-web",
    "portalWebPath": "portal-web",
    "adminApiPath": "apps/admin-api",
    "portalApiPath": "apps/portal-api",
    "workerPath": "apps/worker",
    "migratorPath": "migrator",
    "migrationDirectory": "migrations",
    "migratorMigrationDirectory": "migrator/migrations",
    "migrationChecksumManifestPath": "migrations/checksums.json",
    "requiredMigrationPath": "migrations/0011_stage6_trip_publication.cjs",
    "migrationRunnerEntrypoint": "migrator/dist/packages/migrator/src/run-migrations.js",
    "canonicalMigrationRunner": "migrator/dist/tooling/database/migration-runner.js",
    "instanceManifestPath": "instance-manifest/development.example.json"
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "name": "travelos_development",
    "tlsPolicy": "DISABLED_LOOPBACK_ONLY",
    "runtimeIdentities": {
      "adminApi": {
        "roleName": "travelos_admin_api",
        "connectionExpected": true,
        "systemdCredentialName": "admin-api-db"
      },
      "portalApi": {
        "roleName": "travelos_portal_api",
        "connectionExpected": true,
        "systemdCredentialName": "portal-api-db"
      },
      "worker": {
        "roleName": "travelos_worker",
        "connectionExpected": false,
        "systemdCredentialName": null,
        "manifestCredentialReference": "systemd-credential:worker-db"
      }
    }
  },
  "migrator": {
    "executor": "travelos-migrator-exec",
    "deploymentEntrypoint": "migrator/run-stage6-migrations.mjs",
    "credentialName": "migrator-db",
    "credentialSource": "/etc/credstore.encrypted/travelos-migrator-db",
    "sessionUser": "travelos_migrator",
    "roleSwitch": "SET ROLE travelos_owner",
    "currentUser": "travelos_owner",
    "helperEnvironment": {
      "host": "PGHOST",
      "port": "PGPORT",
      "database": "PGDATABASE",
      "sessionUser": "PGUSER",
      "credentialsDirectory": "CREDENTIALS_DIRECTORY"
    }
  },
  "services": [
    {
      "unit": "travelos-admin-api.service",
      "user": "travelos-admin",
      "group": "travelos-runtime",
      "workingDirectory": "/opt/travelos/current/apps/admin-api",
      "execStart": [
        "/opt/travelos/current/runtime/node/bin/node",
        "/opt/travelos/current/apps/admin-api/dist/main.js",
        "--manifest",
        "/etc/travelos/instances/development.json"
      ],
      "credentials": [
        {
          "kind": "LoadCredentialEncrypted",
          "name": "admin-api-db",
          "source": "/etc/credstore.encrypted/travelos-admin-api-db"
        },
        {
          "kind": "LoadCredentialEncrypted",
          "name": "staff-auth-realm",
          "source": "/etc/credstore.encrypted/travelos-staff-auth-realm"
        }
      ],
      "databaseRole": "travelos_admin_api",
      "listener": {
        "host": "127.0.0.1",
        "port": 3101,
        "healthMethod": "GET",
        "healthPath": "/health/live"
      }
    },
    {
      "unit": "travelos-portal-api.service",
      "user": "travelos-portal",
      "group": "travelos-runtime",
      "workingDirectory": "/opt/travelos/current/apps/portal-api",
      "execStart": [
        "/opt/travelos/current/runtime/node/bin/node",
        "/opt/travelos/current/apps/portal-api/dist/main.js",
        "--manifest",
        "/etc/travelos/instances/development.json"
      ],
      "credentials": [
        {
          "kind": "LoadCredentialEncrypted",
          "name": "portal-api-db",
          "source": "/etc/credstore.encrypted/travelos-portal-api-db"
        },
        {
          "kind": "LoadCredentialEncrypted",
          "name": "portal-auth-realm",
          "source": "/etc/credstore.encrypted/travelos-portal-auth-realm"
        }
      ],
      "databaseRole": "travelos_portal_api",
      "listener": {
        "host": "127.0.0.1",
        "port": 3102,
        "healthMethod": "GET",
        "healthPath": "/health/live"
      }
    },
    {
      "unit": "travelos-worker.service",
      "user": "travelos-worker",
      "group": "travelos-runtime",
      "workingDirectory": "/opt/travelos/current/apps/worker",
      "execStart": [
        "/opt/travelos/current/runtime/node/bin/node",
        "/opt/travelos/current/apps/worker/dist/main.js",
        "--manifest",
        "/etc/travelos/instances/development.json"
      ],
      "credentials": [],
      "databaseRole": "travelos_worker",
      "listener": null
    }
  ],
  "provenance": {
    "requiredReleaseFields": [
      "schemaVersion",
      "artifactId",
      "designation",
      "productionSigning",
      "source",
      "toolchain",
      "qualification",
      "database",
      "deployables",
      "runtime",
      "deploymentContract"
    ],
    "requiredSourceFields": [
      "branch",
      "commit",
      "tree",
      "successorBaselineGeneration",
      "successorBaselineSha256",
      "lockfilePath",
      "lockfileSha256"
    ],
    "externalCiReceiptRequired": true,
    "archiveSha256RequiredInExternalReceipt": true
  }
}
