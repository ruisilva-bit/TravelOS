{
  "manifestSchemaVersion": 3,
  "environment": "DEVELOPMENT",
  "instanceId": "travelos-dev-ct200",
  "compatibility": {
    "releaseVersion": "0.0.0-stage4",
    "releaseTarget": "development:ct200",
    "configSchemaVersion": 3,
    "databaseSchema": {
      "minimum": 6,
      "maximum": 6
    },
    "postgresqlMajor": 18
  },
  "hosts": {
    "admin": "travelos.lan"
  },
  "hostAllowlist": [
    {
      "host": "travelos.lan",
      "surface": "ADMIN"
    }
  ],
  "agencyBootstrap": {
    "reference": "agency-bootstrap:ct200",
    "slug": "travelos-agency"
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "name": "travelos_prod",
    "tlsPolicy": "DISABLED_LOOPBACK_ONLY",
    "runtimeRoles": {
      "adminApi": {
        "roleName": "travelos_admin_api",
        "credentialReference": "systemd-credential:admin-api-db"
      },
      "worker": {
        "roleName": "travelos_worker",
        "credentialReference": "systemd-credential:worker-db"
      }
    }
  },
  "authentication": {
    "staffRealmCredentialReference": "systemd-credential:staff-auth-realm"
  },
  "runtime": {
    "listeners": {
      "adminApi": {
        "host": "127.0.0.1",
        "port": 3101
      }
    },
    "shutdownGracePeriodMs": 5000
  },
  "features": {
    "foundationHealthEndpoints": true
  },
  "safeLimits": {
    "maxRequestBodyBytes": 1048576
  }
}
