{
	admin off
}

http://admin.travelos.test {
	bind 192.168.1.33
	route {
		@api path /api /api/* /health /health/*
		handle @api {
			reverse_proxy 127.0.0.1:3101
		}
		handle {
			root * /opt/travelos/current/admin-web
			header Cache-Control "private, no-store"
			file_server {
				hide .*
			}
		}
	}
}

http://portal.travelos.test {
	bind 192.168.1.33
	route {
		@api path /api /api/* /health /health/*
		handle @api {
			reverse_proxy 127.0.0.1:3102 {
				header_up -X-Forwarded-Host
			}
		}
		handle {
			root * /opt/travelos/current/portal-web
			header Cache-Control "private, no-store"
			file_server {
				hide .*
			}
		}
	}
}

:80 {
	bind 192.168.1.33
	respond 421
}
