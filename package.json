{
  "name": "@travelos/workspace",
  "version": "0.0.0-stage2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "protected-baseline:check": "node tooling/ci/verify-protected-baseline.mjs",
    "format": "node tooling/ci/format-stage-2.mjs --write && node tooling/ci/verify-protected-baseline.mjs",
    "format:check": "node tooling/ci/format-stage-2.mjs --check && node tooling/ci/verify-protected-baseline.mjs",
    "lint": "eslint apps packages tooling *.ts *.mjs",
    "typecheck": "tsc -p tooling/ci/tsconfig.typecheck.json --noEmit && tsc -p tooling/ci/tsconfig.owned-declarations.json --noEmit",
    "verify:dependency-universe": "node tooling/architecture/verify-dependency-universe.mjs",
    "architecture:check": "node tooling/architecture/check.mjs",
    "test:unit": "vitest run --config tooling/testing/vitest.config.ts",
    "build": "node tooling/ci/clean-build-output.mjs && pnpm -r --if-present build",
    "test:smoke": "node tooling/testing/smoke-built.mjs",
    "config:schema:generate": "tsx tooling/ci/write-instance-manifest-schema.ts",
    "config:schema:check": "tsx tooling/ci/write-instance-manifest-schema.ts --check",
    "verify:pins": "node tooling/ci/verify-pins.mjs",
    "test:lifecycle-policy": "node tooling/ci/test-lifecycle-policy.mjs",
    "test:freeze-inputs": "node tooling/ci/test-stage-2-freeze-inputs.mjs",
    "test:security-scanner": "node tooling/ci/test-sensitive-data-scanner.mjs",
    "test:rejected-technologies": "node tooling/ci/test-rejected-technologies.mjs",
    "verify:rejected-technologies": "node tooling/ci/verify-rejected-technologies.mjs",
    "security:scan:source": "node tooling/ci/scan-source-secrets.mjs",
    "security:scan:bundles": "node tooling/ci/scan-browser-bundles.mjs",
    "security:scan": "pnpm security:scan:source && pnpm security:scan:bundles",
    "ci:verify": "node tooling/ci/verify.mjs",
    "evidence:stage2": "node tooling/ci/capture-stage-2-evidence.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "better-auth": "1.6.27",
    "decimal.js": "10.6.0",
    "kysely": "0.29.5",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.29",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.27",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
