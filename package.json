{
  "name": "@travelos/workspace",
  "version": "0.0.0-stage4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "format": "node tooling/ci/format.mjs --write",
    "format:check": "node tooling/ci/format.mjs --check",
    "lint": "eslint apps packages tooling tests migrations *.ts *.mjs",
    "typecheck": "tsc -p tooling/ci/tsconfig.typecheck.json --noEmit && tsc -p tooling/ci/tsconfig.owned-declarations.json --noEmit",
    "build": "node tooling/ci/clean-build-output.mjs && pnpm -r --if-present build",
    "test": "vitest run --config tooling/testing/vitest.config.ts",
    "test:db": "node tooling/database/run-postgres-integration.mjs",
    "test:smoke": "node tooling/testing/smoke-built.mjs",
    "architecture:check": "node tooling/architecture/check.mjs",
    "security:scan": "node tooling/ci/scan-current-source.mjs && node tooling/ci/test-browser-bundle-scan.mjs && node tooling/ci/scan-browser-bundles.mjs",
    "test:security": "node tooling/ci/test-sensitive-data-scanner.mjs && node --test tooling/ci/test-scan-current-source.mjs",
    "verify:pins": "node tooling/ci/verify-pins.mjs",
    "config:schema:generate": "tsx tooling/ci/write-instance-manifest-schema.ts",
    "config:schema:check": "tsx tooling/ci/write-instance-manifest-schema.ts --check",
    "db:migrate": "tsx tooling/database/run-migrations.ts up",
    "db:migrations:status": "tsx tooling/database/run-migrations.ts status",
    "db:migrations:verify": "tsx tooling/database/verify-migration-checksums.ts",
    "auth:bootstrap-first-owner": "tsx tooling/auth/bootstrap-first-owner.ts",
    "auth:schema:verify": "tsx tooling/auth/verify-better-auth-schema-drift.ts",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup.sh",
    "check": "node tooling/ci/verify-current.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "better-auth": "1.6.27",
    "decimal.js": "10.6.0",
    "kysely": "0.29.5",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.29",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.27",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
