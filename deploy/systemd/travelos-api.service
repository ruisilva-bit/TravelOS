# Install: sudo cp deploy/systemd/*.service deploy/systemd/*.timer /etc/systemd/system/
[Unit]
Description=TravelOS admin API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=travelos
Group=travelos
WorkingDirectory=/srv/travelos
ExecStart=/srv/travelos-toolchain/node-v24.19.0-linux-x64/bin/node apps/admin-api/dist/main.js --manifest /etc/travelos/travelos.json
Restart=on-failure
RestartSec=3
# Secrets: names match the credential references in the manifest.
LoadCredential=admin-api-db:/etc/travelos/credentials/admin-api-db
LoadCredential=staff-auth-realm:/etc/travelos/credentials/staff-auth-realm
# Hardening: the API only reads the checkout and talks to PostgreSQL on loopback.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
